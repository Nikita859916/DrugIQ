{
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "extends": [
    "airbnb-base"
  ],
  "parserOptions": {
    "ecmaVersion": 2021
  },
  "rules": {
    "no-console": "warn",
    "no-underscore-dangle": ["error", { "allow": ["_id", "__v"] }],
    "import/no-extraneous-dependencies": ["error", { "devDependencies": ["**/*.test.js", "**/seed/**"] }],
    "consistent-return": "off",
    "no-restricted-syntax": "off",
    "no-await-in-loop": "off"
  }
}
