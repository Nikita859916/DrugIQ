# ─── Environment ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
HOST=localhost

# ─── MongoDB ─────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/drugiq
MONGO_TEST_URI=mongodb://localhost:27017/drugiq_test

# ─── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── JWT Authentication ──────────────────────────────────────────
JWT_ACCESS_SECRET=drugiq_access_super_secret_key_change_in_production_32bytes
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=drugiq_refresh_super_secret_key_change_in_production_32bytes
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=drugiq_cookie_secret_key_32bytes

# ─── Rate Limiting ───────────────────────────────────────────────
# Window in milliseconds (15 minutes default)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP
RATE_LIMIT_MAX=100

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=debug
LOG_DIR=logs

# ─── API Docs ────────────────────────────────────────────────────
SWAGGER_ENABLED=true
API_BASE_URL=http://localhost:5000
